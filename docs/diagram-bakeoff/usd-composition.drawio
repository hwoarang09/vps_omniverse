<mxfile host="diagram-agent" type="device">
  <diagram name="usd-composition-LIVRPS" id="usd-comp">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="USD 레이어 합성 (LIVRPS) — line_cut 이 base 를 비파괴 오버라이드" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="root" value="out/composed.usda (root layer)&#10;subLayers = [ line_cut.usda, base.usda ]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=center;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="linecut" value="line_cut.usda&#10;&#10;over /World/Rails&#10;{&#10;  invisibleIds = [3, 7, 12, ...]&#10;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="100" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="basel" value="base.usda&#10;&#10;def /World/Rails&#10;{&#10;  # raw 2줄 전부 (모든 세그먼트)&#10;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="280" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="result" value="합성 결과 스테이지&#10;/World/Rails&#10;= raw − invisibleIds&#10;(겹친 레일 정리됨)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="190" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note" value="인덱스 정합: base / line_cut 모두&#10;geometry.dual_rail_segments_tagged 공유 → 1:1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="460" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ea" value="① 강함" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;" edge="1" parent="1" source="root" target="linecut"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb" value="② 약함" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="root" target="basel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec" value="오버라이드 승" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="linecut" target="result"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed" value="베이스 제공" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="basel" target="result"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
