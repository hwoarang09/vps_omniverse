#usda 1.0
(
    # 레이어 합성(LIVRPS) stitch. 위(강)부터 아래(약)로 겹친다.
    #   cut.usda  : over /World/Rails { positions/orientations/scales/protoIndices }
    #               겹침을 '정확한 기하'로 트림한 인스턴스 배열을 통째로 override(비파괴).
    #   base.usda : raw 풀길이 2줄 레일 + 스테이션/바닥/카메라 (지오메트리 원본).
    # cut 줄을 지우면 base 의 raw 2줄로 복귀. 맵 데이터와 무관한 정적 파일.
    subLayers = [
        @./cut.usda@,
        @./base.usda@
    ]
    upAxis = "Z"
)
